{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tw-vtuber-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Public custom domain. Required for the Cache API to actually cache
  // (caching is a no-op on *.workers.dev). Cloudflare auto-provisions the
  // DNS record + TLS cert for this hostname on deploy.
  "routes": [{ "pattern": "twvtuber.oshi.tw", "custom_domain": true }],

  // MCP server runs as a Durable Object (McpAgent, per-session, SQLite-backed).
  "durable_objects": {
    "bindings": [{ "name": "VTUBER_MCP", "class_name": "VTuberMCP" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VTuberMCP"] }],

  // Per-IP rate limiting (free binding; per-colo, 60s window).
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }
  ],

  // Upstream data source. Change-detection uses the raw URL (not rate-limited
  // like the GitHub API); bulk file fetches use the jsDelivr CDN mirror.
  "vars": {
    "DATA_RAW_URL": "https://raw.githubusercontent.com/TaiwanVtuberData/TaiwanVTuberTrackingDataJson",
    "DATA_CDN_URL": "https://cdn.jsdelivr.net/gh/TaiwanVtuberData/TaiwanVTuberTrackingDataJson",
    "DATA_SOURCE_REPO": "https://github.com/TaiwanVtuberData/TaiwanVTuberTrackingDataJson"
  },

  // D1: queryable layer (current snapshot + daily history). database_id is filled
  // in by `wrangler d1 create tw-vtuber` (Phase 1 resource creation).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tw-vtuber",
      "database_id": "6308879c-1f54-4238-b21d-a77f2e45f85a",
      "migrations_dir": "./migrations"
    }
  ],

  // R2: full-fidelity raw-snapshot archive (re-derive history if schema changes).
  "r2_buckets": [
    { "binding": "RAW_ARCHIVE", "bucket_name": "tw-vtuber-raw" }
  ],

  // Daily ingestion (UTC). 21:00 UTC ≈ 05:00 Taiwan; adjust as desired.
  "triggers": { "crons": ["0 21 * * *"] }

}
