{
  "name": "tw-vtuber-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public MCP server + REST API for Taiwan VTuber data on Cloudflare",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cf-types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply tw-vtuber --local",
    "db:migrate:remote": "wrangler d1 migrations apply tw-vtuber --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.9",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.94.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.13.2",
    "zod": "^4.4.3"
  }
}
